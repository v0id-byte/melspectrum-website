{
  "name": "melspectrum-website",
  "version": "1.0.0",
  "description": "融谱智能科技 MelSpectrum — 让机器听懂声音",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:fonts": "node scripts/subset-fonts.mjs",
    "assets:images": "node scripts/process-images.mjs",
    "assets": "npm run assets:fonts && npm run assets:images",
    "verify:stage": "node scripts/verify-build.mjs build-stage",
    "publish:build": "node scripts/publish-build.mjs",
    "verify:root": "node scripts/verify-build.mjs .",
    "build": "npm run assets && vite build && npm run verify:stage && npm run publish:build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.17"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
